+pub(crate) fn spill_stackmap_values<'a>(
+    ctx: &mut Context<'a, '_>,
+) -> Result<Vec<(PointerValue<'a>, BasicTypeEnum<'a>)>> {
+    let current_fn = ctx.current_fn.expect("should define current function");
+    let entry = current_fn
+        .get_first_basic_block()
+        .expect("should define function entry block");
+    let alloca_builder = ctx.ictx.create_builder();
+    if let Some(first) = entry.get_first_instruction() {
+        alloca_builder.position_before(&first);
+    } else {
+        alloca_builder.position_at_end(entry);
+    }
+
+    let mut spills = Vec::new();
+    for value in &ctx.stack_frames.last().unwrap().stack {
+        let value_ty = value.get_type();
+        let spill = alloca_builder.build_alloca(value_ty, "stackmap.spill")?;
+        ctx.builder.build_store(spill, *value)?;
+        spills.push((spill, value_ty));
+    }
+    Ok(spills)
+}
