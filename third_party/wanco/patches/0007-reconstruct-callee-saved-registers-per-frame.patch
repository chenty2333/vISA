+static unw_word_t require_unwind_register(unw_cursor_t &cursor,
+                                          int register_number,
+                                          const char *register_name) {
+  unw_word_t value = 0;
+  const int status = unw_get_reg(&cursor, register_number, &value);
+  if (status != 0) {
+    Fatal() << "Failed to read unwind register " << register_name << ": "
+            << unw_strerror(status) << " (" << status << ")\n";
+    exit(EXIT_FAILURE);
+  }
+  return value;
