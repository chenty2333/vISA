@@ -50,8 +50,33 @@ static stackmap_table populate_stackmap(const stackmap::Stackmap &stackmap) {
   return map;
 }
 
+static bool is_supported_stackmap_gap(int32_t pc_offset, uint64_t pc,
+                                      uint32_t instruction_offset) {
+  auto difference =
+      static_cast<int32_t>(instruction_offset) - pc_offset;
+  if (std::abs(difference) <= 3)
+    return true;
+
+#if defined(__x86_64__) || defined(_M_X64)
+  // libunwind reports the return PC immediately after a call. LLVM may place
+  // the stackmap after the four-byte stack adjustment that removes outgoing
+  // stack arguments. Accept that gap only when the intervening machine
+  // instruction is exactly `add imm8, %rsp`; do not broadly weaken record
+  // matching for unrelated code.
+  auto *instruction = reinterpret_cast<const uint8_t *>(pc);
+  const auto adjustment = instruction[3];
+  if (difference == 4 && instruction[0] == 0x48 && instruction[1] == 0x83 &&
+      instruction[2] == 0xc4 && adjustment > 0 && adjustment < 0x80 &&
+      adjustment % 8 == 0)
+    return true;
+#endif
+
+  return false;
+}
