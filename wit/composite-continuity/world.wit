package visa:composite-continuity@0.1.0;

interface workload {
    use visa:continuity/key-value@0.1.0.{namespace, kv-error};
    use visa:continuity/timers@0.1.0.{timer-binding, timer-error, arm-result};
    use visa:file-continuity/regular-file@0.1.0.{
        file-binding,
        file-error,
        file-observation,
        read-result,
        durability,
    };
    use visa:request-continuity/logical-request@0.1.0.{
        request-binding,
        request-error,
        request-observation,
        observe-result,
        continuity-disposition,
        delivery-policy,
        idempotency,
        replay-policy,
        request-phase,
        request-rejection,
        response-metadata,
        transport,
    };

    // Structural copies of visa:file-continuity/workload.component-state and
    // visa:request-continuity/workload.component-state. Aliasing them across
    // packages would pull those whole `workload` interfaces into this world as
    // imports, obliging the host to implement every one of their functions, so
    // the records are redeclared here instead. The cell crate's drift tests pin
    // these declarations against the upstream packages field by field.
    enum file-phase {
        active,
        frozen,
    }

    record file-state {
        session-id: string,
        relative-path: string,
        logical-offset: u64,
        version: u64,
        size: u64,
        content-digest: list<u8>,
        durable-through: durability,
        lock-held: bool,
        last-operation-id: option<string>,
        phase: file-phase,
    }

    enum request-lifecycle {
        active,
        frozen,
    }

    record request-state {
        session-id: string,
        peer-identity: string,
        credential-reference: string,
        transport: transport,
        delivery: delivery-policy,
        replay: replay-policy,
        idempotency: idempotency,
        timeout-ms: u64,
        max-request-size: u32,
        max-response-size: u32,
        operation-id: string,
        request-size: u32,
        request-digest: list<u8>,
        request-phase: request-phase,
        response-cursor: u32,
        response: option<response-metadata>,
        rejection: option<request-rejection>,
        disposition: continuity-disposition,
        lifecycle: request-lifecycle,
    }

    enum composite-phase {
        active,
        frozen,
    }

    record timer-kv-state {
        key: string,
        expected-version: u64,
        completion-value: list<u8>,
        timer-operation-id: option<string>,
        timer-idempotency-key: string,
        completion-idempotency-key: string,
        timer-completed: bool,
    }

    record composite-state {
        session-id: string,
        timer-kv: timer-kv-state,
        file: file-state,
        request: request-state,
        phase: composite-phase,
    }

    variant composite-error {
        already-active,
        invalid-state,
        wrong-timer,
        safe-point-unavailable,
        kv(kv-error),
        timer(timer-error),
        file(file-error),
        request(request-error),
    }

    activate: func(
        session-id: string,
        state: composite-state,
        kv: own<namespace>,
        timer: own<timer-binding>,
        file: own<file-binding>,
        request: own<request-binding>,
    ) -> result<_, composite-error>;

    kv-put: func(idempotency-key: string, value: list<u8>) -> result<u64, composite-error>;
    kv-get: func() -> result<option<u64>, composite-error>;
    timer-arm: func(duration-ns: u64) -> result<arm-result, composite-error>;
    timer-fired: func(operation-id: string) -> result<_, composite-error>;
    file-append: func(
        idempotency-key: string,
        bytes: list<u8>,
        durability: durability,
    ) -> result<file-observation, composite-error>;
    file-read: func(max-bytes: u32) -> result<read-result, composite-error>;
    request-start: func(bytes: list<u8>) -> result<request-observation, composite-error>;
    request-observe: func(max-bytes: u32) -> result<observe-result, composite-error>;

    freeze: func() -> result<composite-state, composite-error>;
    thaw: func(
        state: composite-state,
        kv: own<namespace>,
        timer: own<timer-binding>,
        file: own<file-binding>,
        request: own<request-binding>,
    ) -> result<_, composite-error>;
    restore: func(
        state: composite-state,
        remaining-duration-ns: option<u64>,
        kv: own<namespace>,
        timer: own<timer-binding>,
        file: own<file-binding>,
        request: own<request-binding>,
    ) -> result<_, composite-error>;
    status: func() -> option<composite-state>;
}

world composite-continuity {
    import visa:continuity/key-value@0.1.0;
    import visa:continuity/timers@0.1.0;
    import visa:file-continuity/regular-file@0.1.0;
    import visa:request-continuity/logical-request@0.1.0;
    export workload;
}
